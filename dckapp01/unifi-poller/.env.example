# unifi-poller Secrets
# Kopiere diese Datei nach .env und fülle die Werte aus.
# Die echten Werte liegen in 1Password unter "homelab-docker .env" (Site-unabhängiger Restore).

# UniFi-Controller-Login (apiadmin User auf der UDM)
UP_UNIFI_DEFAULT_PASS=changeme

# InfluxDB v2 Token (idbapp01 - org "Smart Home", bucket "unifi", write-permission)
UP_INFLUXDB_AUTH_TOKEN=changeme
